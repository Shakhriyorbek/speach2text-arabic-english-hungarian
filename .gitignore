# Python
__pycache__/
*.pyc

# Virtual environment (recreated by install.bat)
venv/

# Built/downloaded models (recreated by install.bat — large, not for version control)
# en-hu-ct2 is ~77 MB, nllb-600m-ct2 is ~600 MB. Everything under models/ is
# generated, so ignore the lot and keep the .gitkeep that holds the directory.
models/*
!models/.gitkeep

# The GPU pod's URL — machine-specific, and it changes every time a pod is
# created. pod_url.txt.example is committed as the template.
pod_url.txt

# The rented pod we are currently paying for, so STOP.bat and the next
# START.bat can find it. Machine-specific and short-lived.
.pod_state.json
